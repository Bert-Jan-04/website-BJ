---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import site from '../data/site.json';
import contact from '../data/contact.json';

const waHref = `https://wa.me/${site.whatsapp}`;
const telHref = `+${site.whatsapp}`;
---

<BaseLayout title="Contact — SportSEO Specialist" description={contact.hero.subtitle} current="contact">
  <main id="top">
    <section style="padding:60px 24px 80px;">
      <h1 style="font-size:clamp(38px,6.4vw,84px);line-height:1;letter-spacing:-.04em;font-weight:900;color:#fff;max-width:820px;margin:0 0 24px;">{contact.hero.title}</h1>
      <p style="max-width:620px;font-size:clamp(16px,1.5vw,19px);line-height:1.55;color:#d8d8d6;margin:0;">{contact.hero.subtitle}</p>
    </section>

    <section style="padding:0 24px 100px;">
      <div style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:64px;align-items:start;">
        <div>
          <p class="eyebrow">Direct contact</p>
          <a href={`mailto:${site.email}`} style="display:block;font-size:clamp(24px,3.2vw,38px);font-weight:800;letter-spacing:-.03em;color:#fff;margin-bottom:16px;overflow-wrap:break-word;">{site.email}</a>
          <a href={`tel:${telHref}`} style="display:block;font-size:clamp(24px,3.2vw,38px);font-weight:800;letter-spacing:-.03em;color:#fff;margin-bottom:32px;">{site.phone}</a>
          <a href={waHref} target="_blank" rel="noreferrer" class="btn" style="background:#25d366;color:#fff;gap:10px;">
            <svg viewBox="0 0 24 24" fill="currentColor" style="width:18px;height:18px;"><path d="M20.5 3.5A11 11 0 0 0 2.1 17.8L1 23l5.3-1.1A11 11 0 0 0 21.5 12a10.9 10.9 0 0 0-1-8.5zM12 20.2a9.1 9.1 0 0 1-4.7-1.3l-.3-.2-3.1.6.7-3-.2-.3A9.2 9.2 0 1 1 12 20.2zm5.1-6.9c-.3-.1-1.6-.8-1.9-.9s-.4-.1-.6.1-.7.9-.8 1-.3.2-.6.1a7.5 7.5 0 0 1-2.2-1.4 8.3 8.3 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.4-.5.1-.3a.5.5 0 0 0 0-.5c0-.1-.6-1.5-.8-2s-.4-.5-.6-.5h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-1 2.2 5.2 5.2 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4.1 15.7 15.7 0 0 0 1.6.6 3.8 3.8 0 0 0 1.8.1 2.9 2.9 0 0 0 1.9-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.6-.3z"></path></svg>
            App direct
          </a>
          <div style="margin-top:56px;">
            <p class="eyebrow">Socials</p>
            <div style="display:grid;gap:10px;">
              <a href={site.instagramUrl} target="_blank" rel="noreferrer" style="font-size:16px;width:max-content;">Instagram</a>
              <a href="https://www.tiktok.com" target="_blank" rel="noreferrer" style="font-size:16px;width:max-content;">TikTok</a>
              <a href="https://www.linkedin.com" target="_blank" rel="noreferrer" style="font-size:16px;width:max-content;">LinkedIn</a>
              <a href="https://www.youtube.com" target="_blank" rel="noreferrer" style="font-size:16px;width:max-content;">YouTube</a>
            </div>
          </div>
        </div>

        <div class="scan-card" style="width:100%;">
          <p class="eyebrow">{contact.form.eyebrow}</p>
          <h3 style="font-size:28px;letter-spacing:-.03em;margin:0 0 24px;color:#fff;">{contact.form.title}</h3>
          <form data-contact-form>
            <label>
              Naam
              <input name="name" type="text" placeholder="Jouw naam" required />
            </label>
            <label>
              E-mailadres
              <input name="email" type="email" placeholder="jij@bedrijf.nl" required />
            </label>
            <label>
              Bericht
              <textarea name="message" placeholder="Vertel kort waar je hulp bij zoekt" required rows="4"></textarea>
            </label>
            <button type="submit" class="btn btn-solid">Versturen</button>
            <p class="final-note"><i></i> {contact.form.note}</p>
          </form>
          <div data-contact-done hidden>
            <p style="color:#fff;font-size:18px;line-height:1.5;margin:0;">Bedankt<span data-contact-name></span>! Je bericht is verstuurd, ik reageer snel.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <WhatsAppButton />
</BaseLayout>
