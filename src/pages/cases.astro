---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScanModal from '../components/ScanModal.astro';
import cases from '../data/cases.json';
---

<BaseLayout title="Klantcases — SportSEO Specialist" description={cases.hero.subtitle} current="cases">
  <main id="top">
    <section style="padding:60px 24px 80px;">
      <h1 style="font-size:clamp(38px,6.4vw,84px);line-height:1;letter-spacing:-.04em;font-weight:900;color:#fff;max-width:820px;margin:0 0 24px;">{cases.hero.title}</h1>
      <p style="max-width:620px;font-size:clamp(16px,1.5vw,19px);line-height:1.55;color:#d8d8d6;margin:0;">{cases.hero.subtitle}</p>
    </section>

    <section style="background:#ecebe6;color:#111;padding:0 22px 90px;">
      <div style="max-width:1180px;margin:0 auto;display:grid;gap:64px;">
        {cases.cases.map((item, i) => (
          <article style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:48px;align-items:center;">
            <div class="tablet-mock" style={i % 2 === 1 ? 'order:1;' : undefined}>
              <div class="tablet-mock-inner">
                <div class="tablet-mock-rig">
                  <img class="tablet-mock-arm tl" src={`/assets/images/${item.armPrefix}-arm-tl.png`} alt="" />
                  <img class="tablet-mock-arm br" src={`/assets/images/${item.armPrefix}-arm-br.png`} alt="" />
                  <div class="tablet-mock-bezel">
                    <span class="tablet-mock-cam"></span>
                    <div class="tablet-mock-screen">
                      <div class="tablet-mock-film">
                        {item.slides.map((slide) => <img src={slide.src} alt={slide.alt} />)}
                        <img src={item.slides[0].src} alt="" />
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div style={i % 2 === 1 ? 'order:2;' : undefined}>
              <img src={item.logo} alt={item.id} style={`height:${item.logoHeight};width:auto;margin-bottom:20px;${item.grayscaleLogo ? 'filter:grayscale(1) brightness(0);' : ''}`} />
              <h2 style="font-size:clamp(28px,3.4vw,44px);font-weight:800;letter-spacing:-.03em;margin:0 0 16px;">{item.title}</h2>
              <p style="font-size:16px;line-height:1.6;color:#333;margin:0 0 20px;">{item.description}</p>
              {item.stats && (
                <div style="display:grid;gap:14px;margin:0 0 20px;">
                  {item.stats.map((stat) => (
                    <div>
                      <strong style="display:block;font-size:21px;font-weight:800;letter-spacing:-.02em;color:#111;">{stat.label}</strong>
                      {stat.detail && <span style="font-size:14px;color:#666;">{stat.detail}</span>}
                    </div>
                  ))}
                </div>
              )}
              {item.outro && <p style="font-size:15px;line-height:1.6;color:#333;margin:0 0 20px;">{item.outro}</p>}
              <div style="display:flex;flex-wrap:wrap;gap:8px;">
                {item.tags.map((tag) => (
                  <span style="border:1px solid #ccc;border-radius:999px;padding:6px 12px;font-size:13px;color:#333;">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section style="background:#111;color:#fff;padding:110px 24px;text-align:center;">
      <h2 style="font-size:clamp(32px,4.6vw,58px);font-weight:800;letter-spacing:-.03em;margin:0 0 16px;">{cases.cta.title}</h2>
      <p style="font-size:17px;color:#d8d8d6;margin:0 0 32px;">{cases.cta.subtitle}</p>
      <button type="button" class="btn btn-solid" data-open-scan>{cases.cta.buttonLabel}</button>
    </section>
  </main>

  <ScanModal showDock={true} />
</BaseLayout>
