---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScanModal from '../components/ScanModal.astro';
import about from '../data/over-mij.json';

const reel = [...about.reel, ...about.reel];
const kernBg: Record<string, string> = { dark: 'kern--dark', stone: 'kern--stone', paper: 'kern--paper', mist: 'kern--mist' };
---

<BaseLayout title="Over mij — SportSEO Specialist" description={about.intro.text} current="over-mij" showKernPager={true}>
  <main id="top">
    <section class="about-hero">
      <h1 class="title-marquee">
        <span class="title-marquee__track">
          <span>{about.marqueeTitle}</span>
          <span>{about.marqueeTitle}</span>
        </span>
      </h1>
      <div style="position:relative;overflow:hidden;padding:0 24px;">
        <div style={`display:flex;gap:16px;width:max-content;animation:marquee-x 34s linear infinite;`}>
          {reel.map((item) => (
            <article class="about-card">
              {item.type === 'video' ? (
                <video autoplay muted loop playsinline preload="auto" poster={item.poster}>
                  <source src={item.src} type="video/mp4" />
                </video>
              ) : (
                <img src={item.src} alt={item.alt} />
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section style="padding:40px 32px 80px;">
      <h2 style="max-width:720px;font-size:clamp(36px,5vw,68px);line-height:.95;letter-spacing:-.045em;margin-bottom:36px;color:#fff;">{about.intro.title}</h2>
      <div class="excellence-grid">
        <figure class="excellence-photo">
          <img src={about.intro.photo} alt="Bert-Jan aan het hardlopen" />
        </figure>
        <div class="excellence-side">
          <p>{about.intro.text}</p>
          <div class="tag-row">
            {about.intro.tags.map((tag) => <span>{tag}</span>)}
          </div>
          <figure class="founders">
            <span class="tag">{about.intro.badgeLabel}</span>
            <span class="badge-pill">
              <strong>{about.intro.badgeStat.value}</strong>
              <span>{about.intro.badgeStat.label}</span>
            </span>
            <img src={about.intro.badgePhoto} alt="Bert-Jan aan de bal" />
          </figure>
        </div>
      </div>
    </section>

    <section data-theme="light" class="manifesto" style="padding:110px 48px 90px;">
      <p class="eyebrow">{about.story.eyebrow}</p>
      <h2>{about.story.title}</h2>
      <div class="manifesto-cols">
        {about.story.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section style="padding:90px 24px 0;text-align:center;">
      <h2 style="font-size:clamp(36px,5.4vw,72px);letter-spacing:-.045em;margin-bottom:48px;color:#fff;">{about.clients.title}</h2>
      <div class="partner-marquee" aria-label="Merken">
        <div class="partner-marquee__track">
          {[...about.clients.logos, ...about.clients.logos].map((logo) => (
            <span><img src={logo.src} alt={logo.alt} style={`height:${logo.height};`} /></span>
          ))}
        </div>
      </div>
    </section>

    {about.kern.map((section, i) => (
      <section data-theme="light" data-kern={section.id} class={`kern ${kernBg[section.variant]}`}>
        <div class="kern-meta"><span>{section.eyebrow}</span><span>{section.id} / 04</span></div>
        <h2>
          <em>{section.titleThin}</em>
          <b>{section.titleBold}</b>
        </h2>
        <p>{section.text}</p>
        {section.tags && (
          <div class="kern-tags">{section.tags.map((tag) => <span>{tag}</span>)}</div>
        )}
        <figure class={`kern-media ${section.imageTag ? 'kern-media--dark' : ''}`}>
          {section.imageTag && <span class="kern-media-tag">{section.imageTag}</span>}
          <img src={section.image} alt={section.titleBold} />
        </figure>
      </section>
    ))}

    <section data-theme="light" class="manifesto">
      <p class="eyebrow">{about.manifesto.eyebrow}</p>
      <h2>{about.manifesto.title}</h2>
      <p style="max-width:720px;margin:0 auto 56px;color:#444;line-height:1.55;">{about.manifesto.intro}</p>
      <div class="manifesto-cols">
        {about.manifesto.reasons.map((reason) => (
          <div>
            <p style="font-weight:700;margin-bottom:8px;">{reason.title}</p>
            <p>{reason.text}</p>
          </div>
        ))}
      </div>
      <a href="/contact" class="btn" style="background:#111;color:#fff;margin-bottom:56px;">{about.manifesto.buttonLabel}</a>
      <div class="manifesto-stats">
        {about.manifesto.stats.map((stat) => (
          <div><strong>{stat.value}</strong><span>{stat.label}</span></div>
        ))}
      </div>
    </section>

    <section style="background:#000;color:#fff;padding:90px 24px 80px;">
      <h2 style="max-width:1040px;font-size:clamp(32px,5vw,68px);line-height:.95;letter-spacing:-.045em;margin-bottom:40px;text-align:center;margin-left:auto;margin-right:auto;">
        <span style="display:block;">{about.closing.titleLine1}</span>
        <span style="display:block;">{about.closing.titleLine2}</span>
      </h2>
      <div class="decade-grid">
        {about.closing.images.map((img) => (
          <article>
            <img src={img.src} alt={img.alt} />
            {img.tag && <span class="tag">{img.tag}</span>}
          </article>
        ))}
      </div>
    </section>
  </main>

  <ScanModal showDock={true} />
</BaseLayout>
