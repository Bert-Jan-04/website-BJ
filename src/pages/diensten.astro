---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScanModal from '../components/ScanModal.astro';
import diensten from '../data/diensten.json';

const seo = diensten.seo;
const marketing = diensten.marketing;
---

<BaseLayout title="Diensten — SportSEO Specialist" description={diensten.hero.subtitle} current="diensten">
  <main id="top">
    <section style="padding:60px 24px 90px;">
      <h1 style="font-size:clamp(38px,6.4vw,84px);line-height:1;letter-spacing:-.04em;font-weight:900;color:#fff;max-width:820px;margin:0 0 24px;">{diensten.hero.title}</h1>
      <p style="max-width:620px;font-size:clamp(16px,1.5vw,19px);line-height:1.55;color:#d8d8d6;margin:0 0 36px;">{diensten.hero.subtitle}</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;">
        {diensten.hero.chips.map((chip) => (
          <a href={chip.href} style="font-size:14px;font-weight:600;color:#fff;border:1px solid rgba(255,255,255,.5);border-radius:999px;padding:10px 18px;">{chip.label}</a>
        ))}
      </div>
    </section>

    <section data-theme="light" style="background:#f6f6f3;color:#111;padding:90px 32px;">
      <div style="max-width:1240px;margin:0 auto;">
        <p style="font-size:13px;color:#777;margin:0 0 12px;">{diensten.designMarketing.eyebrow}</p>
        <h2 style="font-size:clamp(30px,4vw,52px);font-weight:800;letter-spacing:-.03em;max-width:640px;margin:0 0 16px;">{diensten.designMarketing.title}</h2>
        <p style="font-size:17px;line-height:1.55;color:#333;max-width:620px;margin:0 0 48px;">{diensten.designMarketing.intro}</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(340px, 1fr));gap:24px;">
          {diensten.designMarketing.cards.map((card) => (
            <article id={card.anchorId} class="service-card">
              <span class="service-card-tag">{card.tag}</span>
              <h3>{card.title}</h3>
              <p style="font-size:15px;line-height:1.55;color:#333;margin:0;">{card.desc}</p>
              {card.idealFor && (
                <div class="service-card-group">
                  <p>Ideaal voor</p>
                  <div class="service-card-chips">{card.idealFor.map((t: string) => <span>{t}</span>)}</div>
                </div>
              )}
              {card.group1 && (
                <div class="service-card-group">
                  <p>{card.group1.label}</p>
                  <div class="service-card-chips">{card.group1.items.map((t: string) => <span>{t}</span>)}</div>
                </div>
              )}
              {card.formatChips && (
                <div class="service-card-formats">
                  {card.formatChips.map((fc: { ratio: string; label: string }) => (
                    <div><strong>{fc.ratio}</strong><span>{fc.label}</span></div>
                  ))}
                </div>
              )}
              <a href="#" data-open-scan style="font-size:14px;font-weight:600;color:#111;width:max-content;">{card.ctaLabel || 'Offerte aanvragen →'}</a>
              <ul class="service-card-features">
                {card.features.map((feat: string) => <li><span>✓</span><span>{feat}</span></li>)}
              </ul>
              <button type="button" class="btn btn-dark" data-open-scan>{card.ctaLabel || 'Offerte aanvragen →'}</button>
              {card.microCopy && <p class="service-card-micro">{card.microCopy}</p>}
              {card.addons && (
                <div class="service-card-addons">
                  {card.addons.map((addon: { label: string; price: string }) => (
                    <div><span>{addon.label}</span><span>{addon.price}</span></div>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section data-theme="light" style="background:#111;color:#fff;padding:90px 32px;">
      <div style="max-width:780px;margin:0 auto;">
        <article id={seo.anchorId} class="service-card service-card--dark">
          <span class="service-card-tag">{seo.tag}</span>
          <h2>{seo.title}</h2>
          <p style="font-size:16px;line-height:1.55;color:#d8d8d6;margin:0;">{seo.desc}</p>
          <div class="service-card-group">
            <p>Ideaal voor</p>
            <div class="service-card-chips">{seo.idealFor.map((t) => <span>{t}</span>)}</div>
          </div>
          <div class="service-card-stats">
            {seo.stats.map((stat) => (
              <div><strong>{stat.value}</strong><span>{stat.label}</span></div>
            ))}
          </div>
          <div class="service-card-group">
            <p>{seo.group1.label}</p>
            <div class="service-card-chips">{seo.group1.items.map((t) => <span>{t}</span>)}</div>
          </div>
          <a href="#" data-open-scan style="font-size:14px;font-weight:600;color:#fff;width:max-content;">Offerte aanvragen →</a>
          <ul class="service-card-features">
            {seo.features.map((feat) => <li><span>✓</span><span>{feat}</span></li>)}
          </ul>
          <button type="button" class="btn btn-solid" data-open-scan>Offerte aanvragen →</button>
          <p class="service-card-micro">{seo.microCopy}</p>
          <div class="service-card-addons">
            {seo.addons.map((addon) => (
              <div><span>{addon.label}</span><span>{addon.price}</span></div>
            ))}
          </div>
        </article>
      </div>
    </section>

    <section data-theme="light" style="background:#e4e2d8;color:#111;padding:90px 32px;">
      <div style="max-width:780px;margin:0 auto;">
        <article id={marketing.anchorId} class="service-card">
          <span class="service-card-tag">{marketing.tag}</span>
          <h2>{marketing.title}</h2>
          <p style="font-size:16px;line-height:1.55;color:#333;margin:0;">{marketing.desc}</p>
          <div class="service-card-group">
            <p>Ideaal voor</p>
            <div class="service-card-chips">{marketing.idealFor.map((t) => <span>{t}</span>)}</div>
          </div>
          <div class="service-card-group">
            <p>{marketing.group1.label}</p>
            <div class="service-card-chips">{marketing.group1.items.map((t) => <span>{t}</span>)}</div>
          </div>
          <a href="#" data-open-scan style="font-size:14px;font-weight:600;color:#111;width:max-content;">Offerte aanvragen →</a>
          <ul class="service-card-features">
            {marketing.features.map((feat) => <li><span>✓</span><span>{feat}</span></li>)}
          </ul>
          <button type="button" class="btn btn-dark" data-open-scan>Offerte aanvragen →</button>
          {marketing.addons && (
            <div class="service-card-addons">
              {marketing.addons.map((addon) => (
                <div><span>{addon.label}</span><span>{addon.price}</span></div>
              ))}
            </div>
          )}
        </article>
      </div>
    </section>

    <section data-theme="light" style="background:#d8d6ce;color:#111;padding:90px 32px;">
      <div style="max-width:1240px;margin:0 auto;">
        <p style="font-size:13px;color:#777;margin:0 0 12px;">{diensten.automatisering.eyebrow}</p>
        <h2 style="font-size:clamp(30px,4vw,52px);font-weight:800;letter-spacing:-.03em;max-width:640px;margin:0 0 16px;">{diensten.automatisering.title}</h2>
        <p style="font-size:17px;line-height:1.55;color:#333;max-width:620px;margin:0 0 48px;">{diensten.automatisering.intro}</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(340px, 1fr));gap:24px;">
          {diensten.automatisering.cards.map((card) => (
            <article id={card.anchorId} class="service-card">
              <span class="service-card-tag">{card.tag}</span>
              <h3>{card.title}</h3>
              <p style="font-size:15px;line-height:1.55;color:#333;margin:0;">{card.desc}</p>
              {card.group1 && (
                <div class="service-card-group">
                  <p>{card.group1.label}</p>
                  <div class="service-card-chips">{card.group1.items.map((t: string) => <span>{t}</span>)}</div>
                </div>
              )}
              {card.group2 && (
                <div class="service-card-group">
                  <p>{card.group2.label}</p>
                  <div class="service-card-chips">{card.group2.items.map((t: string) => <span>{t}</span>)}</div>
                </div>
              )}
              <a href="#" data-open-scan style="font-size:14px;font-weight:600;color:#111;width:max-content;">Offerte aanvragen →</a>
              <ul class="service-card-features">
                {card.features.map((feat: string) => <li><span>✓</span><span>{feat}</span></li>)}
              </ul>
              <button type="button" class="btn btn-dark" data-open-scan>Offerte aanvragen →</button>
              {card.microCopy && <p class="service-card-micro">{card.microCopy}</p>}
              {card.addons && (
                <div class="service-card-addons">
                  {card.addons.map((addon: { label: string; price: string }) => (
                    <div><span>{addon.label}</span><span>{addon.price}</span></div>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section style="background:#000;color:#fff;padding:100px 24px;">
      <div style="max-width:1240px;margin:0 auto;">
        <p style="font-size:13px;color:#8a8a8a;margin:0 0 12px;">{diensten.werkwijze.eyebrow}</p>
        <h2 style="font-size:clamp(34px,4.6vw,64px);font-weight:800;letter-spacing:-.03em;margin:0 0 16px;">{diensten.werkwijze.title}</h2>
        <p style="font-size:17px;line-height:1.55;color:#d8d8d6;max-width:600px;margin:0 0 48px;">{diensten.werkwijze.subtitle}</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:20px;">
          {diensten.werkwijze.steps.map((step) => (
            <div class="step-card">
              <span>{step.tag}</span>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
              <ul>{step.items.map((it) => <li><span>✓</span><span>{it}</span></li>)}</ul>
              <span class="duration">{step.duration}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section style="background:#111;color:#fff;padding:110px 24px;text-align:center;">
      <h2 style="font-size:clamp(32px,4.6vw,58px);font-weight:800;letter-spacing:-.03em;margin:0 0 16px;">{diensten.cta.title}</h2>
      <p style="font-size:17px;color:#d8d8d6;margin:0 0 32px;">{diensten.cta.subtitle}</p>
      <button type="button" class="btn btn-solid" data-open-scan>{diensten.cta.buttonLabel}</button>
    </section>
  </main>

  <ScanModal showDock={true} />
</BaseLayout>
