---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScanModal from '../components/ScanModal.astro';
import site from '../data/site.json';
import home from '../data/home.json';
---

<BaseLayout title="SportSEO Specialist — Websites, marketing & automatisering voor sportbedrijven" description={home.hero.subtitle} current="home">
  <main id="top">
    <section class="hero">
      <h1>
        <span>{home.hero.titleLine1}</span>
        <span>{home.hero.titleLine2}</span>
        <span>{home.hero.titleLine3}</span>
      </h1>
      <p class="hero-sub">{home.hero.subtitle}</p>
      <div class="hero-ctas">
        <button class="btn btn-solid" type="button" data-open-scan>{home.hero.ctaLabel}</button>
        <a class="who-link" href="#about">
          <img src="/assets/images/team-meeting.png" alt="SportSEO Specialist" />
          <span>{home.hero.whoLinkLabel}</span>
        </a>
      </div>
    </section>

    <section class="clients-section" id="about">
      <div class="logo-wall" aria-label="Bedrijven die ik help">
        {home.logos.map((logo) => (
          <img src={logo.image} alt={logo.name} style="height:28px;width:auto;filter:grayscale(1) brightness(1.7);" />
        ))}
      </div>

      <div class="arc">
        {home.arcCards.map((card, i) => {
          const rotations = [-22, -13, -4, 4, 13];
          const ys = [56, 22, 4, 4, 22];
          return (
            <article class="arc-card" style={`--r:${rotations[i]}deg; --y:${ys[i]}px;`}>
              <img src={card.image} alt={card.alt} />
              {card.mark && <span class="arc-mark">SEO</span>}
            </article>
          );
        })}
      </div>

      <p class="about-copy">{home.aboutTeaser}</p>
      <button class="btn btn-ghost" type="button" data-open-scan>{home.hero.ctaLabel}</button>
    </section>

    <section class="stats-section">
      <div class="stats">
        {home.stats.map((stat) => (
          <div>
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="tiktok-section" id="work">
      <div class="tiktok-head">
        <div>
          <h2>{home.shorts.title}</h2>
          <p>{home.shorts.subtitle}</p>
        </div>
        <p class="tiktok-stat">{home.shorts.stat}</p>
      </div>

      <div class="tiktok-grid" id="tiktok">
        {home.playground.tiles.map((tile) => (
          <a class="video-card" href={tile.link}>
            <img src={tile.image} alt={tile.label} />
            <span class="video-caption">{tile.label}</span>
          </a>
        ))}
        <a class="video-card" href="/cases">
          <img src="/assets/images/rebuild-slide-1.jpg" alt="Rebuild" />
          <span class="video-caption">Rebuild</span>
        </a>
      </div>
    </section>

    <section class="final-hero">
      <div class="final-copy">
        <h2>
          <span>{home.final.titleLine1}</span>
          <span>{home.final.titleLine2}</span>
          <span>{home.final.titleLine3}</span>
        </h2>
        <p>{home.final.subtitle}</p>
        <button class="btn btn-solid" type="button" data-open-scan>{home.hero.ctaLabel}</button>
        <p class="final-note"><i></i> {home.final.note}</p>
      </div>
      <div class="final-visual">
        <span class="giant-word"><b>SPORT</b>SEO</span>
        <img src="/assets/images/team-meeting.png" alt="SportSEO Specialist" />
      </div>
    </section>
  </main>

  <ScanModal />
</BaseLayout>
