---
import site from '../data/site.json';
import regio from '../data/regio.json';
import type { PageKey } from '../layouts/BaseLayout.astro';

interface Props {
  current: PageKey;
}

const { current } = Astro.props;
const isHome = current === 'home';

const pageLinks = isHome
  ? [
      { href: '#top', label: 'Home' },
      { href: '#work', label: 'Playground' },
      { href: '#tiktok', label: 'Shorts' },
      { href: '#about', label: 'Over ons' },
      { href: '#contact', label: 'Contact' },
    ]
  : [
      { href: '/', label: 'Home' },
      { href: '/diensten/', label: 'Diensten' },
      { href: '/cases/', label: 'Klantcases' },
      { href: '/blog/', label: 'Blog' },
      { href: '/over-mij/', label: 'Over ons' },
      { href: '/contact/', label: 'Contact' },
    ];

const footerRegions = regio.cities.filter((c) => c.footer);

const telHref = `+${site.whatsapp}`;
---

<footer class="footer" id="contact" data-footer>
  <div class="footer-grid">
    <div class="footer-col footer-col--contact">
      <p class="eyebrow">Contact</p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={`tel:${telHref}`}>{site.phone}</a>
    </div>
    <div class="footer-col">
      <p class="eyebrow">Pagina's</p>
      {pageLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
    <div class="footer-col">
      <p class="eyebrow">Werkgebied</p>
      {footerRegions.map((c) => <a href={`/regio/${c.slug}/`}>{c.name}</a>)}
      <a href="/regio/">Alle regio's →</a>
    </div>
    <div class="footer-col">
      <p class="eyebrow">Socials</p>
      <a href={site.instagramUrl} target="_blank" rel="noreferrer">Instagram</a>
      <a href={site.tiktokUrl} target="_blank" rel="noreferrer">TikTok</a>
    </div>
  </div>
  <p class="copyright">© 2026 {site.companyName}, alle rechten voorbehouden<br />KVK: {site.kvk} · {site.address}</p>
  <div class="footer-wordmark" aria-hidden="true">SPORTSEOSPECIALIST</div>
</footer>
