---
import WhatsAppButton from './WhatsAppButton.astro';
import site from '../data/site.json';

interface Props {
  showDock?: boolean;
  dockLabel?: string;
}

const { showDock = false, dockLabel = 'Start scan' } = Astro.props;
---

{showDock && (
  <button type="button" class="scan-dock" data-scan-dock data-open-scan>
    {dockLabel}
    <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0l1.1 5.3L16 8l-6.9 2.7L8 16l-1.1-5.3L0 8l6.9-2.7z"/></svg>
  </button>
)}

<WhatsAppButton />

<div class="scan" data-scan hidden>
  <div class="scan-card">
    <button class="scan-close" type="button" data-close-scan aria-label="Sluiten">×</button>
    <p class="eyebrow">Website Scan</p>
    <p class="scan-step-count" data-scan-progress>Vraag 1 van 4</p>

    <form data-scan-form>
      <div class="scan-step is-active" data-scan-step="1">
        <h3>Wat is je merk- of bedrijfsnaam?</h3>
        <label>
          Merknaam
          <input data-scan-brand-input name="brand" type="text" placeholder="Bijv. Sportpoeder" required />
        </label>
        <button class="btn btn-solid" type="button" data-scan-next>Volgende →</button>
      </div>

      <div class="scan-step" data-scan-step="2">
        <h3>Heb je al een website?</h3>
        <div class="scan-options" data-scan-options="website">
          <button type="button" class="scan-option" data-points="10">Ja, en ik ben er tevreden over</button>
          <button type="button" class="scan-option" data-points="35">Ja, maar ik ben er niet tevreden over</button>
          <button type="button" class="scan-option" data-points="50">Nee, nog niet</button>
        </div>
      </div>

      <div class="scan-step" data-scan-step="3">
        <h3>Hoe goed vind je jezelf terug in Google?</h3>
        <div class="scan-options" data-scan-options="google">
          <button type="button" class="scan-option" data-points="5">Ik sta hoog (top 3)</button>
          <button type="button" class="scan-option" data-points="20">Ergens op de eerste pagina</button>
          <button type="button" class="scan-option" data-points="35">Niet op de eerste pagina</button>
          <button type="button" class="scan-option" data-points="30">Weet ik niet</button>
        </div>
      </div>

      <div class="scan-step" data-scan-step="4">
        <h3>Waar wil je de meeste groei behalen?</h3>
        <div class="scan-options" data-scan-options="focus">
          <button type="button" class="scan-option" data-value="Branding & design">Branding &amp; design</button>
          <button type="button" class="scan-option" data-value="Website">Website</button>
          <button type="button" class="scan-option" data-value="SEO & vindbaarheid">SEO &amp; vindbaarheid</button>
          <button type="button" class="scan-option" data-value="Marketing & automatisering">Marketing &amp; automatisering</button>
        </div>
      </div>
    </form>

    <div class="scan-done" data-scan-done hidden>
      <div class="scan-score-ring">
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <circle class="scan-score-track" cx="50" cy="50" r="44"></circle>
          <circle class="scan-score-progress" data-scan-score-circle cx="50" cy="50" r="44"></circle>
        </svg>
        <span class="scan-score-value" data-scan-score>0</span>
      </div>
      <h3 data-scan-verdict>Resultaat</h3>
      <p data-scan-message></p>
      <div class="scan-done-ctas">
        <a class="btn btn-solid" data-scan-whatsapp data-phone={site.whatsapp} target="_blank" rel="noreferrer">App over je resultaat</a>
        <a class="btn btn-ghost" href="/contact">Neem contact op</a>
      </div>
    </div>
  </div>
</div>
